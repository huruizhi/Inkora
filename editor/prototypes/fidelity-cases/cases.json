{
  "schema_version": 1,
  "task": "INK-PROT-002",
  "baseline_commit": "57aeaac18e41c7191b1be851b284aae8c1b1bbae",
  "spec_ref": "docs/markdown-support.md@57aeaac（冻结 1.0，规则 ID 由此引用）",
  "acceptance_basis": "验收依据（2026-11-08 用户最新口径优先）：高级语法不得导致自动整篇退出可视编辑；畸形/含混边界应保留可信视图与原文、阻止不安全结构化保存，由用户主动选择源码修复；「有提示地自动打开整篇源码模式」记为现状差异，不判为通过。docs/markdown-support.md 中 SYN-U/EOL-001 等整篇回退规则仅作现状参照。字节判据与模式/交互判据分别记录，不得以任一模式退路默认当作新体验已满足。",
  "independence": "全部输入、动作与预期仅由冻结规范、03/04/11 号票据与上述验收口径独立推导，未读取也未迎合 INK-PROT-001 原型的任何输出。",
  "verdicts": {
    "byte-exact": "预期文件字节可独立推导；校验器会用 manifest 中的 ops 从前一状态重新推导并比对 sha256。",
    "state-ref": "历史步骤；预期字节必须等于本变体更早出现过的某个状态（输入或此前预期文件）。",
    "operational": "无法在不知道原型界面的情况下给出字节或坐标；给出操作步骤与内容锚点判据，不捏造精确坐标或通过结果。"
  },
  "to_disk": "expect.to_disk=true 表示保存后磁盘应为此字节；false 表示仅缓冲区态（保存被阻止或历史态）。",
